# Neon Postgres connection string WITH pooling enabled (host contains "-pooler").
# Used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Same Neon connection string WITHOUT pooling (no "-pooler" in the host).
# Used only by drizzle-kit for migrations / studio.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign the session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"
